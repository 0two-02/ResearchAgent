# IBM watsonx.ai Credentials (optional — app works without these)
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_URL=https://us-south.ml.cloud.ibm.com

# Groq API Key (used when IBM credentials are absent)
# Get a free key at https://console.groq.com/keys
# Supported models: llama3-70b-8192, llama3-8b-8192, mixtral-8x7b-32768
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# IBM Langflow (optional - if using hosted Langflow)
LANGFLOW_API_KEY=your_langflow_api_key_here
LANGFLOW_BASE_URL=http://localhost:7860

# Academic Source APIs
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
# Note: arXiv, CrossRef, OpenAlex do not require API keys for basic use
# PubMed NCBI API Key (optional, increases rate limits)
NCBI_API_KEY=your_ncbi_api_key_here

# Database
DATABASE_URL=sqlite:///./researchpilot.db
# For PostgreSQL: postgresql://user:password@localhost:5432/researchpilot

# Vector Database
CHROMA_PERSIST_DIRECTORY=./chroma_db

# Application Settings
SECRET_KEY=your-secret-key-here-change-in-production
ENVIRONMENT=development
DEBUG=true
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Demo Mode (set to true to use demo data when APIs are unavailable)
DEMO_MODE=false

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
